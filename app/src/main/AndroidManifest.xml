<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Only to download the official root filesystem of a distro the user chooses to install. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Only to read the device's DNS servers, written to a distro's /etc/resolv.conf (T08b). A normal
         permission: Android grants it without asking. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Keeps the shells alive in the background (SPEC RF-07). specialUse: see DECISIONS.md D-T08-2. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Shows the persistent notification of that service (Android 13+). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Lets the app ask the user, with the system dialog, to run without battery optimisation so a long
         task (an SSH session) is not paused with the screen off (T08c, D-T08c-1). It only opens that
         dialog: nothing changes unless the user accepts. F-Droid allows it; Google Play restricts it,
         and this app is not published there (targetSdk 28), hence the Lint suppression. -->
    <uses-permission
        android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"
        tools:ignore="BatteryLife" />
    <!-- The optional wake lock of the "keep awake" setting. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Only requested when the user turns on the shared storage (T13). The app targets API 28, where
         these are the model for reading and writing /sdcard. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />

    <application
        android:name=".UltimateTerminalApp"
        android:allowBackup="false"
        android:extractNativeLibs="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.UltimateTerminal">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:resizeableActivity="true"
            android:enableOnBackInvokedCallback="true"
            tools:targetApi="33"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density|fontScale|layoutDirection|locale"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".terminal.SessionService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="terminal_sessions" />
        </service>
    </application>
</manifest>
